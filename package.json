{
  "name": "dyad-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Dyad Technologies QA Automation Practical Assessment using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
